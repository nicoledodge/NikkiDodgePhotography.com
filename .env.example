# Runtime defaults. Store actual values in a local ignored .env or Kubernetes Secret.
# Never put credentials in VITE_ variables: those are public browser build settings.
NODE_ENV=development
PORT=5000
PUBLIC_APP_URL=http://localhost:5000
VITE_PORTFOLIO_IMAGE_BASE_URL=

# Preserve the existing CRM and public media configuration during migration.
CRM_S3_BUCKET=
CRM_S3_REGION=us-east-1
CRM_S3_DATA_PREFIX=app-data
CRM_S3_MEDIA_PREFIX=site-assets
CRM_PUBLIC_ASSET_BASE_URL=
CRM_MAX_DIRECT_UPLOAD_BYTES=209715200
AWS_REGION=us-east-1
# Prefer the runtime's IAM role. Set these only if that is unavailable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Stage authentication before enabling bookings. Both default to disabled.
AUTH_ENABLED=false
BOOKING_ENABLED=false
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Stripe test credentials first; live activation requires a verified signed webhook.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Private document bucket, separate from public portfolio/CDN storage.
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_REGION=us-east-1
DOCUMENTS_S3_PREFIX=booking-documents
DOCUMENTS_LOCAL_DIR=data/booking-documents
DOCUMENTS_FONT_PATH=

# SMTP_URL OR explicit SMTP connection fields. Never use a public frontend key.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional encrypted off-site database backups (scripts/backup-booking-db.sh).
BOOKING_BACKUP_DIR=
BACKUP_AGE_RECIPIENT=
BOOKING_BACKUP_S3_URI=

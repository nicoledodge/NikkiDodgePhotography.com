{
  "name": "nikkidodgephotography",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "deploy": "gh-pages -d dist",
    "build:common": "tsc",
    "copy": "ts-node copyHorizontalImages.ts",
    "dev": "vite",
    "lint": "eslint nikkidodgephotography",
    "preview": "vite preview",
    "server:dev": "tsx watch src/server.ts",
    "server:start": "node dist-server/server.js",
    "static": "serve -s dist -l tcp://0.0.0.0:80 --no-clipboard --no-request-logging",
    "static:bg": "pm2 start serve --name nikki-static -- -s dist -l 80"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@types/multer": "^2.1.0",
    "animate.css": "^4.1.1",
    "body-parser": "^1.20.3",
    "bootstrap": "^5.1.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exif-js": "^2.3.0",
    "express": "^4.21.2",
    "font-awesome": "^4.7.0",
    "jimp": "^1.6.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.0",
    "owl.carousel": "^2.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-owl-carousel": "^2.3.3",
    "react-router-dom": "^7.1.5",
    "serve": "^14.2.5",
    "sharp": "^0.33.5",
    "swiper": "^11.2.3",
    "tslib": "2.8.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/bootstrap": "^5.2.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  }
}
